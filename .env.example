# Optional overrides. No secrets here — account tokens live in the macOS Keychain.
# Copy to .env only if you want to change defaults.

# Port the dashboard listens on (default 4319)
# CLAUDE_USAGE_PORT=4319

# Bind host. Default: auto-detected Tailscale IP, else 127.0.0.1.
# Set to 127.0.0.1 to keep it strictly local; set to a tailnet IP to force one.
# CLAUDE_USAGE_BIND=127.0.0.1

# Browser poll interval in ms (default 30000)
# CLAUDE_USAGE_POLL_MS=30000

# Severity thresholds for the UI bars (percent utilization)
# CLAUDE_USAGE_WARN=70
# CLAUDE_USAGE_CRIT=90

# Keychain service name (default claude-usage-dashboard)
# CLAUDE_USAGE_KEYCHAIN=claude-usage-dashboard
