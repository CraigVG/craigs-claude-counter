<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.craigvg.claude-usage-dashboard</string>

  <key>ProgramArguments</key>
  <array>
    <!-- Edit the two absolute paths below to match your machine (which node). -->
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/craigvandergalien/claude-usage-dashboard/src/server.mjs</string>
